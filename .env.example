# Docker Compose environment variables
# Copy to .env and update values before running: cp .env.example .env
# Scope: this file is for compose stack wiring, not the full app/provider config surface.
# Provider/model settings are documented in docs/CONFIGURATION.md and docs/setup/ai-providers.md.

# JWT signing secret (REQUIRED when auth is enabled)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
FO_API_AUTH_JWT_SECRET=

# Redis password (REQUIRED — used by both redis and file-organizer services)
# "changeme" is for local development only — replace in staging/production.
# Avoid special URI characters (@, :, /, #, %) or percent-encode them.
REDIS_PASSWORD=changeme
